# Leave DATABASE_URL unset for local dev: `npm run dev` runs an embedded database.
# On Vercel, adding Neon under Storage sets this for you.
DATABASE_URL=

# Optional: send real password-reset emails via Resend.
RESEND_API_KEY=
EMAIL_FROM="Levitating Notebook <hello@yourdomain.com>"

# Optional: base URL for reset links (defaults to your Vercel production URL).
APP_URL=

# Shown in the privacy policy and terms (/privacy, /terms). Set these before launch.
LEGAL_NAME=
CONTACT_EMAIL=
LEGAL_COUNTRY=
